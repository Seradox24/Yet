# Copiar como .env.prod antes de desplegar.
# Todos los valores GENERATE_ME y example.com deben reemplazarse.

# PostgreSQL
POSTGRES_DB=lrsql
POSTGRES_USER=lrsql
POSTGRES_PASSWORD=GENERATE_ME
# En servidores con datos centralizados, agregar POSTGRES_DATA_PATH=/ruta/absoluta/postgres
# Sin esta variable se conserva el volumen Docker existente.

# Cuenta administrativa inicial de SQL LRS
LRSQL_ADMIN_USER=admin@example.com
LRSQL_ADMIN_PASSWORD=GENERATE_ME

# Credencial inicial para consumir la API xAPI
LRSQL_API_KEY=GENERATE_ME
LRSQL_API_SECRET=GENERATE_ME

# Puerto loopback del backend para Nginx del host
LRSQL_HTTP_PORT=18083
# Origen HTTPS público, sin barra final ni ruta. Completar al elegir el dominio.
LRSQL_PUBLIC_URL=https://lrs.example.com
LRSQL_LOG_LEVEL=INFO

# Identidad de una instalación nueva; omitir conserva yet-lrsql y sus recursos.
COMPOSE_PROJECT_NAME=example-yet-test
POSTGRES_IMAGE=postgres:16.15-alpine3.24@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
LRSQL_IMAGE=yetanalytics/lrsql:v0.9.11@sha256:bf5661ab216d07175f6e429951bf53c79f6070d54812285ea4c208f991cf0a04
POSTGRES_CPUS=1
POSTGRES_MEMORY=512m
LRSQL_CPUS=2
LRSQL_MEMORY=1536m
# Consumida por la JVM al iniciar; valor literal con espacios.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0 -XX:InitialRAMPercentage=10.0

# init crea un perfil separado con estas rutas absolutas y POSTGRES_DATA_PATH.
# SECRET_ROOT/secrets.env contiene solo las cuatro claves privadas anteriores;
# no duplicarlas en el perfil público.
# SECRET_ROOT=/ruta/privada/yet/test
# BACKUP_ROOT=/ruta/respaldos/yet/test
# OPS_ROOT=/ruta/registros/yet/test
# BACKUP_KEEP=7

