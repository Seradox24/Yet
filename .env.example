# Copiar este archivo como .env antes de levantar el ambiente.
# Los valores siguientes son solo ejemplos locales y deben reemplazarse.

# PostgreSQL
POSTGRES_DB=lrsql
POSTGRES_USER=lrsql
POSTGRES_PASSWORD=reemplazar_con_password_postgres

# Cuenta administrativa inicial de SQL LRS
LRSQL_ADMIN_USER=admin
LRSQL_ADMIN_PASSWORD=reemplazar_con_password_admin

# Credencial inicial para consumir la API xAPI
LRSQL_API_KEY=reemplazar_con_api_key
LRSQL_API_SECRET=reemplazar_con_api_secret

# Exposición local del servicio
LRSQL_BIND_ADDRESS=127.0.0.1
LRSQL_HTTP_PORT=8080
LRSQL_LOG_LEVEL=INFO

