server {
    listen 80;
    server_name lrs.example.com;
    return 301 https://lrs.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name lrs.example.com;

    # Las rutas de los certificados deben adaptarse al servidor.
    ssl_certificate /etc/letsencrypt/live/lrs.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lrs.example.com/privkey.pem;

    client_max_body_size 20m;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:18083;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
